{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "vite.config.ts",
      "vitest.config.ts",
      "tsconfig.json",
      "package.json",
      "biome.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noCommonJs": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@tauri-apps/plugin-sql",
                  "@tauri-apps/plugin-sql/**",
                  "better-sqlite3",
                  "better-sqlite3/**",
                  "sqlite3",
                  "sqlite3/**",
                  "sql.js",
                  "sql.js/**",
                  "@sqlite.org/sqlite-wasm",
                  "@sqlite.org/sqlite-wasm/**",
                  "@libsql/**",
                  "node:sqlite"
                ],
                "message": "SQL_UI_IMPORT_DENIED: use a Rust use case."
              }
            ]
          }
        }
      }
    }
  },
  "plugins": [
    {
      "path": "./scripts/no-ui-sql.grit",
      "includes": ["**/src/**"]
    }
  ],
  "assist": {
    "enabled": false
  }
}
